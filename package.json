{
  "name": "kuno-optimizer",
  "version": "1.0.5",
  "description": "PC Optimizer by Kuno — clean, speed up, and monitor your computer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:portable": "electron-builder --win portable",
    "pack": "electron-packager . \"Kuno Optimizer\" --platform=win32 --arch=x64 --out=release --prune --overwrite"
  },
  "build": {
    "appId": "com.kuno.optimizer",
    "productName": "Kuno Optimizer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "node_modules/**/*",
      "!node_modules/electron/dist"
    ],
    "icon": "icon.png",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Kuno-Optimizer-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@electron/packager": "^18.3.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2"
  }
}
